AWS_ENDPOINT_URL=http://floci:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
DATABASE_URL=sqlite:////app/data/lab.db
MISSIONS_DIR=/app/missions
NEXT_PUBLIC_API_URL=http://localhost:8001

# AMA chat (optional) — uncomment and fill in to enable the "Ask me anything" panel
# AI_AGENT_CMD=/app/scripts/ama-agent.py
# AMA_API_BASE=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# AMA_API_KEY=sk-...
# AMA_MODEL=gpt-4o-mini

# Floci image — override the local AWS emulator image. Default is the official
# floci/floci:1.5.13. If that image is unavailable in your registry, substitute
# localstack/localstack:3 (API-compatible drop-in).
# FLOCI_IMAGE=floci/floci:1.5.13
# FLOCI_IMAGE=localstack/localstack:3
